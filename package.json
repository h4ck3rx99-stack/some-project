{
  "name": "cartprobe",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:content": "tsx scripts/build-content.ts",
    "build:validators": "tsx scripts/compile-validators.ts",
    "generate": "npm run build:content && npm run build:validators",
    "dev": "wrangler dev --port 8787",
    "mock-store": "wrangler dev --config test/mock-store/wrangler.toml --port 8788",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cartprobe --local",
    "db:migrate:remote": "wrangler d1 migrations apply cartprobe --remote",
    "seed:local": "tsx scripts/seed.ts > .wrangler/seed.sql && wrangler d1 execute cartprobe --local --file .wrangler/seed.sql",
    "schemas:update": "tsx scripts/update-ucp-schemas.ts",
    "market-count": "tsx scripts/market-count.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1.12",
    "wrangler": "^4.151.1"
  }
}
