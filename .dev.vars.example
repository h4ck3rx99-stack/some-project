# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
ENVIRONMENT=development
APP_URL=http://localhost:8787
APP_DOMAIN=localhost:8787
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
IP_HASH_SALT=dev-ip-salt-change-me
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=CartProbe <dev@localhost>
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=dev-billing-webhook-secret
CHECKOUT_URL_STORE=
CHECKOUT_URL_AGENCY=
CHECKOUT_URL_VENDOR=
ADMIN_EMAILS=admin@example.com
# Routes https://<variant>.mockstore.test/* to the local mock store (development only).
MOCK_STORE_ORIGIN=http://127.0.0.1:8788
